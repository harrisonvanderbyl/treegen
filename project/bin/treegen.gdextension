[configuration]

entry_symbol = "treegen_library_init"
compatibility_minimum = "4.1"
reloadable = false

[libraries]

macos.debug = "./macos/libtreegen.macos.template_debug.dylib"
macos.release = "./macos/libtreegen.macos.template_release.dylib"
macos.debug.double = "./macos/libtreegen.macos.template_debug.double.dylib"
macos.release.double = "./macos/libtreegen.macos.template_release.double.dylib"

windows.debug.x86_32 = "./windows/treegen.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "./windows/treegen.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "./windows/treegen.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./windows/treegen.windows.template_release.x86_64.dll"

linux.debug.x86_64 = "./linux/libtreegen.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./linux/libtreegen.linux.template_release.x86_64.so"
linux.debug.arm64 = "./linux/libtreegen.linux.template_debug.arm64.so"
linux.release.arm64 = "./linux/libtreegen.linux.template_release.arm64.so"

android.debug.x86_64 = "./android/libtreegen.android.template_debug.x86_64.so"
android.release.x86_64 = "./android/libtreegen.android.template_release.x86_64.so"
android.debug.arm64 = "./android/libtreegen.android.template_debug.arm64.so"
android.release.arm64 = "./android/libtreegen.android.template_release.arm64.so"

web.debug.wasm32 = "./web/libtreegen.web.template_debug.wasm32.nothreads.wasm"
web.release.wasm32 = "./web/libtreegen.web.template_release.wasm32.nothreads.wasm"
